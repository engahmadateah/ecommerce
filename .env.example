APP_NAME="My Shop"
APP_ENV=local
APP_KEY=
# Production: APP_ENV=production and APP_DEBUG=false (never leave debug on in a live shop)
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ecommerce
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Use "smtp" (or resend/ses/mailgun) in production. "log" only writes e-mails to storage/logs.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="orders@your-shop.com"
MAIL_FROM_NAME="${APP_NAME}"
# New-order notifications go here (falls back to the e-mail in admin Settings)
MAIL_ADMIN_ADDRESS=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Stripe (use `stripe listen --forward-to localhost:8000/stripe/webhook` locally to get the whsec_ secret)
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# ---- Production extras (see DEPLOYMENT.md) ----
# Faster cache/queue/sessions with Redis (instead of the database):
# CACHE_STORE=redis
# QUEUE_CONNECTION=redis
# SESSION_DRIVER=redis
# Security headers: the CSP starts in report-only mode. Set to false once the browser console (F12) shows no warnings.
# SECURITY_CSP_REPORT_ONLY=true
# Error tracking (optional): composer require sentry/sentry-laravel, then
# SENTRY_LARAVEL_DSN=
# Cart reminder e-mail, product photo WebP, return window:
# SHOP_CART_REMINDER_HOURS=3
# SHOP_IMAGES_WEBP=true
# SHOP_RETURN_DAYS=14
# mysqldump path for db:backup on XAMPP:
# MYSQLDUMP_PATH="C:\xampp\mysql\bin\mysqldump.exe"
